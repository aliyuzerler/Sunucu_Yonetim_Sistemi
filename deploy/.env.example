# Geliştirme ortamı örneği — gerçek değerler .env içinde tutulur (.env gitignored).
# Production secret'ları repoya ASLA girmez; burada yalnızca placeholder var.

# --- Compose: PostgreSQL 18 (geliştirme) ---
POSTGRES_USER=serverctl
POSTGRES_PASSWORD=change-me-dev-only
POSTGRES_DB=server_control

# --- Control Plane ---
CP_HTTP_ADDR=127.0.0.1:8080
CP_LOG_LEVEL=info
CP_LOG_FORMAT=json
# Compose kurulumundan sonra: postgres://<user>:<password>@localhost:5432/<db>?sslmode=disable
CP_DATABASE_URL=postgres://serverctl:change-me-dev-only@localhost:5432/server_control?sslmode=disable

# --- Migration runner (aynı adresi kullanır) ---
# Kullanım: cd backend/control-plane && go run ./cmd/migrate up
